{
  "name": "xp-agent-studio",
  "version": "1.0.0",
  "description": "Windows XP tarzı node-based accessibility agent promptlatıcı — OpenRouter ile",
  "main": "dist-electron/main.js",
  "author": "XP Agent Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.node.json --outDir dist-electron",
    "build:electron": "vite build && tsc -p tsconfig.node.json --outDir dist-electron",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:4521 && electron .\"",
    "pack:win": "npm run build:electron && electron-builder --win portable --x64",
    "pack:dir": "npm run build:electron && electron-builder --dir"
  },
  "build": {
    "appId": "com.xpagentsudio.app",
    "productName": "XP Agent Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "a11y/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "a11y",
        "to": "a11y"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "XP-Agent-Studio.exe"
    },
    "portable": {
      "artifactName": "XP-Agent-Studio.exe"
    },
    "asar": true
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }
}
