{
  "name": "xp-agent-studio",
  "version": "1.9.43",
  "description": "Nubbo Agent Studio — Windows XP tarzı node-based accessibility agent",
  "main": "dist-electron/boot.js",
  "author": "Nubbo Agent Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "npm run build:electron",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "tsc -p tsconfig.node.json --outDir dist-electron",
    "test:input": "npm run build:main && node --test scripts/test-input.cjs",
    "test:recovery": "npm run build:main && node --test scripts/test-input-recovery.cjs",
    "test:targeting": "npm run build:main && node --test scripts/test-targeting.cjs",
    "test:desktop": "npm run build:main && node scripts/run-windows-desktop.cjs",
    "diagnose:click": "npm run build:main && node scripts/run-windows-desktop.cjs --diagnose",
    "replay:target": "npm run build:main && node scripts/replay-target.cjs",
    "test:keys": "node --test scripts/test-key-presets.cjs",
    "test:stability": "npm run build:main && node --test scripts/test-stability-graph.cjs scripts/test-stability-agent.cjs scripts/test-stability-bridge-browser.cjs scripts/test-stability-main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "build:electron": "npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "preview": "vite preview --config vite.renderer.config.ts --host 127.0.0.1 --port 4521",
    "pack:win": "node scripts/stamp-build.cjs && npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable --x64",
    "pack:dir": "node scripts/stamp-build.cjs && npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir"
  },
  "build": {
    "appId": "com.xpagentsudio.app",
    "productName": "Nubbo Agent Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "resources/boot/**/*",
      "!resources/boot/splash.bmp",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll",
      "!dist/**/*.exe",
      "!**/*.exe"
    ],
    "extraResources": [
      {
        "from": "a11y",
        "to": "a11y"
      },
      {
        "from": "ocr",
        "to": "ocr"
      },
      {
        "from": "resources/build.json",
        "to": "build.json"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Nubbo.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Nubbo.exe"
    },
    "asar": true,
    "afterPack": "scripts/after-pack.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "onnxruntime-node": "^1.30.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "pe-library": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^2.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  }
}
