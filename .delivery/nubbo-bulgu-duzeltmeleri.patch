+import { existsSync, mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { withLibraryLock } from '../electron/library-lock'
+import { ZipLibraryStorage } from '../electron/zip-library-storage'
+
+/**
+ * U03 (yönerge) — kütüphane kilidi/okuma yolu klasör OLUŞTURMAZ.
+ *
+ * Ölçülen kusur: `library-lock.ts` içindeki koşulsuz `fs.mkdirSync(directory, { recursive: true })` ve
+ * `zip-library-storage.ts` `sectionDirectory` içindeki aynı çağrı yüzünden, kayıtlı kütüphane yolu
+ * korumalı bir kökte (Windows Denetimli klasör erişimi) ve eksikse `mkdirSync` **süresiz bekliyor**,
+ * açılış "arayüz yükleniyor"da donuyordu. Artık: açma ≠ oluşturma.
+ */
+const olusturulanlar: string[] = []
+const geciciKok = () => {
+  const dir = mkdtempSync(join(tmpdir(), 'nubbo-u03-'))
+  olusturulanlar.push(dir)
+  return dir
+}
+afterEach(() => {
+  for (const d of olusturulanlar.splice(0)) { try { rmSync(d, { recursive: true, force: true }) } catch { /* önemsiz */ } }
+})
+
+describe('U03: kilit ve okuma yolu klasör oluşturmaz', () => {
+  it('var olmayan klasörde kilit alınmaz, klasör OLUŞTURULMAZ ve anlaşılır hata döner', () => {
+    const kok = geciciKok()
+    const yok = join(kok, 'kutuphane-yok')
+    expect(() => withLibraryLock(yok, () => 'yazmamalı')).toThrow(/Kütüphane klasörü bulunamadı/)
+    expect(existsSync(yok)).toBe(false) // ESKİ HATA: burada oluşturuluyordu
+  })
+
+  it('açık istek (olustur=true) verilirse klasör oluşturulur ve işlem çalışır', () => {
+    const kok = geciciKok()
+    const yeni = join(kok, 'yeni-kutuphane')
+    expect(withLibraryLock(yeni, () => 'tamam', true)).toBe('tamam')
+    expect(existsSync(yeni)).toBe(true)
+  })
+
+  it('var olan klasörde okuma çalışır (regresyon)', () => {
+    const kok = geciciKok()
+    const mevcut = join(kok, 'mevcut')
+    withLibraryLock(mevcut, () => undefined, true)
+    expect(withLibraryLock(mevcut, () => 'ok')).toBe('ok')
+  })
+
+  it('storage.load() kayıtlı klasör yoksa OLUŞTURMAZ, anlaşılır hata verir', () => {
+    const kok = geciciKok()
+    const yok = join(kok, 'silinmis-kutuphane')
+    const depo = new ZipLibraryStorage(yok)
+    expect(() => depo.load()).toThrow(/Kütüphane klasörü bulunamadı/)
+    expect(existsSync(yok)).toBe(false) // açılış donması yerine hata
+  })
+})
