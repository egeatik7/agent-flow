     }
   })
 }
+
+/**
+ * SİLME KARARI (yönerge U05 + U06): seçici ile silici **aynı** kuralı uygular ve **canlılık kanıtı
+ * olmadan hiçbir klasör silinmez**.
+ *
+ * Ölçülen kusur: yalnız "bizim exe var + rastgele ad + kendi klasörümüz değil + 10 dk eski" ölçütleriyle
+ * seçilen bir klasör, saatlerdir çalışan **başka bir örneğin** program klasörü olabilir ve doğrudan
+ * `rmSync(recursive, force)` ile silinebiliyordu. Klasör adı, yaş ve exe varlığı canlılık kanıtı değildir.
+ *
+ * Yeni kural: `canliMi` yalnızca **kanıt** döndürür (ör. çalışan örnek kendi exe'sini kilitlediği için
+ * kilit açılamıyorsa "kullanımda"). Kanıt üretilemiyorsa (fonksiyon verilmedi ya da hata verdi) klasör
+ * silinmez, `atlanan` listesinde açık gerekçesiyle raporlanır.
+ */
+export type SupurmeKarari = {
+  silinebilir: GeciciGirdi[]
+  atlanan: { yol: string; neden: string }[]
+}
+
+export function supurmeKarari(
+  girdiler: GeciciGirdi[],
+  opts: { now: number; ownDir?: string; keepMs?: number; canliMi?: (g: GeciciGirdi) => boolean }
+): SupurmeKarari {
+  const silinebilir: GeciciGirdi[] = []
+  const atlanan: { yol: string; neden: string }[] = []
+  for (const g of bayatCikarmaKlasorleri(girdiler, opts)) {
+    if (!opts.canliMi) {
+      atlanan.push({ yol: g.yol, neden: 'canlılık kanıtı yok (sahiplik doğrulanamadı)' })
+      continue
+    }
+    let canli = true
+    try {
+      canli = opts.canliMi(g)
+    } catch {
+      canli = true // kanıt üretilemedi → güvenli taraf
+    }
+    if (canli) atlanan.push({ yol: g.yol, neden: 'klasör kullanımda (canlı örnek)' })
+    else silinebilir.push(g)
+  }
+  return { silinebilir, atlanan }
+}
