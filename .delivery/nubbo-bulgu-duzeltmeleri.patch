+      dugum('a', 'click', { prompt: 'a' }),
+      dugum('b', 'click', { prompt: 'b' }), // kutu DIŞINDA, a'nın aşağı akışı (kutunun çıkış kenarı)
+      dugum('c', 'click', { prompt: 'c' }), // b'nin de aşağı akışı
+    ],
+    edges: [
+      { from: 'basla', fromPort: 'next', to: 'kutu' },
+      { from: 'a', fromPort: 'next', to: 'b' }, // kutu üyesi → kutu dışı = ÇIKIŞ kenarı
+      { from: 'b', fromPort: 'next', to: 'c' },
+    ],
+    packages: [],
+  } as unknown as AgentGraph
+}
+
+const bosPlan = { adds: [], patches: [], edges: [], cuts: [] } as never
+
+describe('U07: kutu üyeliği kutu dışına yayılmaz', () => {
+  it('kutunun çıkış kenarı ve aşağı akışı üye YAPILMAZ', () => {
+    const sonuc = applyPlan(graf(), bosPlan) as unknown as { nodes: { id: string; kind: string; members?: string[] }[] }
+    const kutu = sonuc.nodes.find((n) => n.id === 'kutu')!
+    expect(kutu.members).toContain('a') // mevcut üye korunur
+    expect(kutu.members).not.toContain('b') // ESKİ HATA: çıkış kenarı üyelik sayılıyordu
+    expect(kutu.members).not.toContain('c') // ve geçişli olarak tüm aşağı akış
+  })
+
+  it('kutu üyeleri listesi yalnız kutu içi kalır; grafiğin geri kalanı değişmez', () => {
+    const once = graf()
+    const sonuc = applyPlan(once, bosPlan) as unknown as { nodes: { id: string; kind: string; members?: string[] }[] }
+    const kutular = sonuc.nodes.filter((n) => n.kind === 'loop')
+    expect(kutular).toHaveLength(1)
+    expect(kutular[0].members).toEqual(['a'])
+  })
+})
