+﻿import { mkdtempSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { ZipLibraryStorage } from '../electron/zip-library-storage'
+
+/**
+ * O21 (yönerge) — Windows'ta AYNI SAYILAN iki ZIP adı (NFC normalizasyonu) tüm kütüphaneyi düşürmemeli.
+ *
+ * Ölçülen kusur: `readSnapshot` içindeki çakışma kontrolü per-dosya try'ın DIŞINDA `throw` ediyordu →
+ * snapshot komple başarısız oluyor, kütüphane BOŞ görünüyor ve (hepsi önce readSnapshot çağırdığı için)
+ * tüm kütüphane işlemleri aynı hatayla düşüyordu. Artık sağlam kayıtlar görünür kalır; çakışan kayıtlar
+ * AÇIK hata + kaynak adlarıyla bildirilir ve mevcut `freshGroup` guard'ı sayesinde o kayda YAZILMAZ.
+ */
+const olusturulanlar: string[] = []
+afterEach(() => { for (const d of olusturulanlar.splice(0)) { try { rmSync(d, { recursive: true, force: true }) } catch { /* önemsiz */ } } })
+
+describe('O21: çakışan ZIP adı kütüphaneyi düşürmez', () => {
+  it('çakışma olsa bile load() hata vermez; çakışanlar gerekçeyle bildirilir, dosyalar silinmez', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'nubbo-o21-'))
+    olusturulanlar.push(dir)
+    // NFC farkı: önceden birleşik 'é' ile 'e' + birleşen aksan aynı fileKey'e düşer (Windows'ta iki AYRI dosya).
+    writeFileSync(join(dir, 'Saglam.zip'), 'bu gecerli bir nubbo zip i degil')
+    writeFileSync(join(dir, 'Caf\u00e9.zip'), 'x')
+    writeFileSync(join(dir, 'Cafe\u0301.zip'), 'y')
+
+    const depo = new ZipLibraryStorage(dir)
+    let anlik: { groups: { id: string; problem?: string }[] } | null = null
+    expect(() => { anlik = depo.load() as never }).not.toThrow() // ESKİ HATA: burada throw ediyordu
+
+    const gruplar = anlik!.groups
+    expect(gruplar).toHaveLength(3) // sağlam kayıt GÖRÜNÜR kalır
+    const cakisan = gruplar.filter((g) => (g.problem ?? '').includes('aynı sayılan iki ZIP adı'))
+    expect(cakisan).toHaveLength(2) // İKİ taraf da açık gerekçe taşır
+    expect(cakisan.every((g) => /Caf/.test(g.problem ?? ''))).toBe(true) // kaynak adları mesajda
+    expect(readdirSync(dir).filter((n) => n.endsWith('.zip'))).toHaveLength(3) // hiçbir dosya silinmedi
+  })
+})
